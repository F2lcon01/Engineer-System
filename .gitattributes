# Keep shell scripts as LF — bash on macOS/Linux breaks on CRLF
*.sh           text eol=lf
*.bash         text eol=lf

# PowerShell scripts: CRLF on Windows
*.ps1          text eol=crlf
*.psm1         text eol=crlf
*.psd1         text eol=crlf

# Node hooks (v3.2+): cross-platform — LF in repo, no shebang dependency
*.mjs          text eol=lf
*.js           text eol=lf
*.cjs          text eol=lf

# Markdown, JSON, configs: normalize to LF in repo
*.md           text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf
